{
  "name": "mduik-2026",
  "version": "1.0.0",
  "private": true,
  "description": "MDUIK School Administration System - multi-tenant admissions, records and finance platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "worker:dev": "wrangler dev",
    "db:local": "wrangler d1 execute mduik-db --local --file=./schema.sql",
    "db:seed": "wrangler d1 execute mduik-db --local --file=./seed.sql",
    "db:remote": "wrangler d1 execute mduik-db --remote --file=./schema.sql",
    "deploy": "vite build && wrangler deploy",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "dependencies": {
    "hono": "^4.9.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "vite": "^7.1.3",
    "wrangler": "^4.127.0"
  }
}
